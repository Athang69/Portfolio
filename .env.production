# Public, client-side values. Safe to commit: Web3Forms access keys are
# designed to be embedded in client code, and NEXT_PUBLIC_* is inlined at
# build time anyway. Vercel picks this up automatically on every build.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_WEB3FORMS_KEY=c33217df-be20-495d-9eb9-741a56eef460
